diff --git a/radio/rfsimulator/haps/test_haps_rain.c b/radio/rfsimulator/haps/test_haps_rain.c
new file mode 100644
index 0000000..4c703ff
--- /dev/null
+++ b/radio/rfsimulator/haps/test_haps_rain.c
@@ -0,0 +1,63 @@
+#include "haps_rain.h"
+
+#include <stdio.h>
+
+int main(void)
+{
+  haps_rain_input_t input = {
+      .frequency_ghz = 3.6192,
+      .elevation_deg = 44.87,
+      .polarization_tilt_deg = 45.0,
+      .rain_rate_mm_per_h = 25.0,
+      .rain_height_km = 5.0,
+      .station_height_km = 0.0
+  };
+
+  haps_rain_result_t result = {0};
+
+  const int rc =
+      haps_rain_compute(
+          &input,
+          &result);
+
+  if (rc != 0) {
+    fprintf(
+        stderr,
+        "haps_rain_compute failed: %d\n",
+        rc);
+
+    return 1;
+  }
+
+  printf("valid              = %d\n",
+         result.valid);
+
+  printf("k_H                = %.12f\n",
+         result.k_h);
+
+  printf("k_V                = %.12f\n",
+         result.k_v);
+
+  printf("alpha_H            = %.12f\n",
+         result.alpha_h);
+
+  printf("alpha_V            = %.12f\n",
+         result.alpha_v);
+
+  printf("k                  = %.12f\n",
+         result.k);
+
+  printf("alpha              = %.12f\n",
+         result.alpha);
+
+  printf("gamma_R            = %.12f dB/km\n",
+         result.specific_attenuation_db_per_km);
+
+  printf("rain_path          = %.12f km\n",
+         result.geometric_rain_path_km);
+
+  printf("rain_attenuation   = %.12f dB\n",
+         result.attenuation_db);
+
+  return 0;
+}
